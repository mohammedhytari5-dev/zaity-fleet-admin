# Copy this file to .env and fill values for the target environment.
NODE_ENV=development
PORT=3000
# Bind address. Development defaults to 127.0.0.1 so an accidentally exposed
# dev server cannot reach the network; production defaults to 0.0.0.0.
# HOST=0.0.0.0
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
VITE_APP_ID=
# REQUIRED, minimum 32 characters. Sessions are signed with HS256; a missing or
# short value makes session tokens forgeable, so the server refuses to start in
# production and refuses to sign or verify tokens at all. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Local-only escape hatch for GET /api/oauth/mock, which creates a synthetic
# administrator account and a long-lived session with no credentials.
# It is NEVER registered when NODE_ENV=production. Leave it unset unless you
# deliberately need it, and never enable it on an instance pointed at a real
# database.
# ALLOW_MOCK_OAUTH=true
